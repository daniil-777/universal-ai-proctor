HOST=127.0.0.1
PORT=8101
MOCK=0

# Configure at least one provider. Credentials remain server-side.
OPENAI_API_KEY=
# Professional AI voice for guidance and answers. Cedar is a recommended quality voice.
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=cedar
# Set TTS_MODEL=tts-1 to use the legacy speech model.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
HF_API_KEY=

# Optional local vision provider, e.g. an installed Ollama model.
# LOCAL_LLM_ENDPOINT=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=llava

# Optional binary locations when ffmpeg/ffprobe are not on PATH.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# Persistent accounts and saved training snapshots. Keep this directory on a
# persistent server disk and outside publicly served folders. Back it up privately.
# DATA_DIR=.data/accounts
# For an online HTTPS deployment, configure the exact app origin (no trailing slash).
# ACCOUNT_PUBLIC_ORIGIN=https://guide.example.com
# NODE_ENV=production
# Production/HTTPS accounts use Secure, HttpOnly, SameSite=Strict cookies.
# For local HTTP development only, an explicit override is available:
# ACCOUNT_COOKIE_SECURE=false
