# Copy to .env on the selected VM only; .env is excluded from Git and Docker builds.
# Plain public hostname: no https:// prefix, port, path or trailing slash.
APP_DOMAIN=guide.example.com
ACME_EMAIL=owner@example.com

# Add provider credentials privately only when ready to enable live AI usage.
# The app can start without keys; live provider analysis needs a configured key.
# API/model usage is separate from free Oracle hosting.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
HF_API_KEY=
